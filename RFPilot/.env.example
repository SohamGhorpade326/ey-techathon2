# Backend API URL
# If RFPPilot2 backend runs on port 8001, point here to http://127.0.0.1:8001
VITE_API_URL=http://127.0.0.1:8001

# Clerk publishable key for frontend (required for ClerkProvider)
VITE_CLERK_PUBLISHABLE_KEY=pk_XXXXXXXXXXXXXXXXXXXXXXXX

# Groq API Key (for frontend AI features)
VITE_GROQ_API_KEY=your_groq_api_key_here
