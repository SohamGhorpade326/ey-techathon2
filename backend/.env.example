# MongoDB URI
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Server Port
PORT=5000

# Groq API Key for AI Insights
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Secret for Authentication (if using local JWT auth)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Optional Clerk configuration (if migrating to Clerk for auth)
# CLERK_ISSUER=https://api.clerk.com
# CLERK_JWKS_URL=https://api.clerk.com/.well-known/jwks.json
