# MongoDB Atlas Connection (required)
MONGO_URI2=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0

# Server Configuration - align with code (main_new.py uses 8001 by default)
# Use PORT=8001 unless you change the uvicorn run command
PORT=8001

# Gmail SMTP Configuration (optional)
GMAIL_SENDER_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Groq API Key (for AI cover letter generation)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk configuration (used for SAML/JWT verification)
# In production, set these and replace the demo JWT decoder with a proper JWKS verifier
CLERK_ISSUER=https://api.clerk.com
CLERK_JWKS_URL=https://api.clerk.com/.well-known/jwks.json
# Optional: server API key for Clerk admin operations
CLERK_API_KEY=sk_XXXXXXXXXXXXXXXX
